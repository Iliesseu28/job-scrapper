{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run sources)",
      "Bash(npm run stats)",
      "Bash(npm run filter)",
      "Bash(npm run collect:*)",
      "Bash(npm test)",
      "Bash(node --test:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-secrets.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-after-edit.mjs\"", "timeout": 120 }
        ]
      }
    ]
  }
}
