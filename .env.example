# ============================================================================
# Copy this file to .env and fill in what you use. .env is git-ignored.
# Every key is optional except the AI ones: a source whose key is missing is
# simply skipped (`npm run sources` shows what will run).
# ============================================================================

# --- AI scoring (required to score) --------------------------------------------
# gemini | anthropic | openai | mistral | groq | deepseek | openrouter | ollama | custom
AI_PROVIDER=gemini
AI_API_KEY=
# Optional — a default is used per provider (gemini-2.5-flash, claude-haiku-4-5, gpt-4.1-mini…)
AI_MODEL=
# Only for AI_PROVIDER=custom (any OpenAI-compatible endpoint)
AI_BASE_URL=

# --- Official job APIs (free keys) ------------------------------------------------
# https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# https://francetravail.io → create an app with the "Offres d'emploi v2" API
FRANCE_TRAVAIL_ID=
FRANCE_TRAVAIL_SECRET=
# https://jooble.org/api/about
JOOBLE_API_KEY=

# --- Paid -------------------------------------------------------------------------
# https://fantastic.jobs (LinkedIn + ATS offers; free trial)
FANTASTIC_JOBS_API_KEY=

# --- Job sites' own search keys (public, sent to every visitor's browser) ----------
# Open the site, DevTools → Network, search "algolia": copy the application id and
# the search-only API key from the request headers. See README → Sources.
WTTJ_APP_ID=
WTTJ_API_KEY=
STATIONF_ALGOLIA_APP_ID=
STATIONF_ALGOLIA_KEY=
# X-API-KEY header sent by mon-vie-via.businessfrance.fr (VIE catalogue)
VIE_API_KEY=

# --- Optional ------------------------------------------------------------------------
# Where offers are stored (default: ./data)
# JOBSCRAPER_DATA_DIR=
# Viewer port (default: 4321)
# VIEWER_PORT=
